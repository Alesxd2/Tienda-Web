@model TiendaWeb.Models.Estilo

@{
    ViewData["Title"] = "Eliminar Estilo";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TiendaWeb</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">TiendaWeb</a>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-primary fw-bold" href="/Admin/Estilos">Estilos (Admin)</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container bg-white p-4 rounded shadow-sm border border-danger border-2" style="max-width: 600px;">
        <h1 class="mb-2 text-danger">¿Eliminar Registro?</h1>
        <h5 class="text-muted mb-3">Esta acción no se puede deshacer de la base de datos.</h5>
        <hr />

        <dl class="row my-4">
            <dt class="col-sm-4 fw-bold text-secondary">
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd class="col-sm-8 fw-bold">
                @Html.DisplayFor(model => model.Nombre)
            </dd>

            <dt class="col-sm-4 fw-bold text-secondary mt-2">
                @Html.DisplayNameFor(model => model.Descripcion)
            </dt>
            <dd class="col-sm-8 mt-2">
                @Html.DisplayFor(model => model.Descripcion)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-danger px-4">Sí, Eliminar de todas formas</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar y volver</a>
            </div>
        </form>
    </div>

</body>
</html>