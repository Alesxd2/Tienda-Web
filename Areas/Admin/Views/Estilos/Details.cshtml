@model TiendaWeb.Models.Estilo

@{
    ViewData["Title"] = "Detalles del Estilo";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TiendaWeb</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">TiendaWeb</a>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-primary fw-bold" href="/Admin/Estilos">Estilos (Admin)</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container bg-white p-4 rounded shadow-sm" style="max-width: 600px;">
        <h1 class="mb-3">Detalles del Registro</h1>
        <h4 class="text-muted">Información Completa</h4>
        <hr />

        <dl class="row mt-3">
            <dt class="col-sm-4 fw-bold text-secondary">
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd class="col-sm-8 fs-5 fw-bold">
                @Html.DisplayFor(model => model.Nombre)
            </dd>

            <dt class="col-sm-4 fw-bold text-secondary mt-2">
                @Html.DisplayNameFor(model => model.Descripcion)
            </dt>
            <dd class="col-sm-8 mt-2 text-wrap text-break">
                @Html.DisplayFor(model => model.Descripcion)
            </dd>
        </dl>

        <div class="d-flex gap-2 pt-3 border-top mt-4">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning text-dark fw-bold">Modificar</a>
            <a asp-action="Index" class="btn btn-secondary">Regresar</a>
        </div>
    </div>

</body>
</html>