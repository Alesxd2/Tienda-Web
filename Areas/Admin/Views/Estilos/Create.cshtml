@model TiendaWeb.Models.Estilo

@{
    ViewData["Title"] = "Crear Nuevo Estilo";
    Layout = null; // Vamos a la segura ignorando los Shared externos
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TiendaWeb</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">TiendaWeb</a>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-primary fw-bold" href="/Admin/Estilos">Estilos (Admin)</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container bg-white p-4 rounded shadow-sm" style="max-width: 600px;">
        <h1 class="mb-3">Crear Estilo</h1>
        <h4 class="text-muted">Nuevo Registro</h4>
        <hr />

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-bold"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej. Urbano, Deportivo..." />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label fw-bold"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Añade una descripción..."></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-success">Guardar Estilo</button>
                <a asp-action="Index" class="btn btn-secondary">Regresar al Listado</a>
            </div>
        </form>
    </div>

</body>
</html>