@model IEnumerable<TiendaWeb.Models.Cerveza>

@{
    ViewData["Title"] = "Inventario de Cervezas";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">Panel de Administración</a>
            <div class="navbar-nav">
                <a class="nav-link" href="/Admin/Estilos">Estilos</a>
                <a class="nav-link active fw-bold" href="/Admin/Cervezas">Cervezas</a>
            </div>
        </div>
    </nav>

    <div class="container bg-white p-4 rounded shadow-sm border">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 m-0 text-dark fw-bold">Control de Cervezas</h1>
                <p class="text-muted m-0 small">Gestiona los productos disponibles en el inventario</p>
            </div>
            <a href="/Admin/Cervezas/Crear" class="btn btn-primary fw-bold px-4 shadow-sm">+ Agregar Nueva</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 text-secondary uppercase small fw-bold">@Html.DisplayNameFor(model => model.nombre)</th>
                        <th class="py-3 text-secondary uppercase small fw-bold">@Html.DisplayNameFor(model => model.alcohol)</th>
                        <th class="py-3 text-secondary uppercase small fw-bold">Imagen</th>
                        <th class="py-3 text-secondary uppercase small fw-bold">Estilo</th>
                        <th class="py-3 text-secondary uppercase small fw-bold">@Html.DisplayNameFor(model => model.precio)</th>
                        <th class="py-3 text-center text-secondary uppercase small fw-bold" style="width: 240px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark py-3">
                                @Html.DisplayFor(modelItem => item.nombre)
                            </td>

                            <td>
                                <span class="text-muted fw-semibold">@Html.DisplayFor(modelItem => item.alcohol)%</span>
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.UrlImagen))
                                {
                                    <img src="@item.UrlImagen" alt="Foto" class="rounded shadow-sm border" style="width: 50px; height: 50px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted small">No foto</span>
                                }
                            </td>

                            <td>
                                <span class="badge bg-secondary px-2.5 py-1.5 rounded text-white">
                                    @Html.DisplayFor(modelItem => item.Estilo.Nombre)
                                </span>
                            </td>

                            <td class="fw-bold text-success">
                                $@Html.DisplayFor(modelItem => item.precio)
                            </td>

                            <td class="text-center">
                                <div class="btn-group shadow-sm" role="group">
                                    <a href="/Admin/Cervezas/Editar/@item.Id" class="btn btn-sm btn-outline-warning fw-semibold">Editar</a>
                                    <a href="/Admin/Cervezas/Detalles/@item.Id" class="btn btn-sm btn-outline-info fw-semibold">Detalles</a>
                                    <a href="/Admin/Cervezas/Eliminar/@item.Id" class="btn btn-sm btn-outline-danger fw-semibold">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>