@model TiendaWeb.Models.Cerveza

@{
    ViewData["Title"] = "Editar Cerveza";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">Panel de Administración</a>
            <div class="navbar-nav">
                <a class="nav-link" href="/Admin/Estilos">Estilos</a>
                <a class="nav-link active fw-bold" href="/Admin/Cervezas">Cervezas</a>
            </div>
        </div>
    </nav>

    <div class="container" style="max-width: 600px;">
        <div class="card shadow-sm border-0 rounded m-4">
            <div class="card-header bg-warning text-dark p-3">
                <h3 class="card-title m-0 h5 fw-bold">Modificar Producto</h3>
            </div>

            <div class="card-body p-4 bg-white">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UrlImagen" />

                    <div class="mb-3">
                        <label asp-for="nombre" class="form-label fw-bold text-secondary">Nombre del Producto</label>
                        <input asp-for="nombre" class="form-control" />
                        <span asp-validation-for="nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="alcohol" class="form-label fw-bold text-secondary">Porcentaje de Alcohol (%)</label>
                        <input asp-for="alcohol" class="form-control" type="number" step="0.1" />
                        <span asp-validation-for="alcohol" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdEstilo" class="form-label fw-bold text-secondary">Estilo Relacionado</label>
                        <select asp-for="IdEstilo" class="form-select"
                                asp-items="@(new SelectList(ViewBag.Estilos, "Id", "Nombre"))">
                        </select>
                        <span asp-validation-for="IdEstilo" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="precio" class="form-label fw-bold text-secondary">Precio ($)</label>
                        <input asp-for="precio" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="precio" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary">Cambiar Imagen del Producto (Opcional)</label>
                        <input type="file" id="subidaArchivo" name="archivoImagen" class="form-control" accept="image/*" />
                        <small class="text-muted d-block mt-1">Deja este campo vacío si deseas conservar la foto que ya tiene el producto.</small>
                    </div>

                    @if (!string.IsNullOrEmpty(Model?.UrlImagen))
                    {
                        <div class="mb-4 text-center p-2 bg-light rounded border">
                            <p class="text-muted small fw-bold m-1">Imagen actual en el servidor:</p>
                            <img src="@Model.UrlImagen" alt="Foto actual" class="img-thumbnail" style="max-height: 120px; object-fit: contain;" />
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a href="/Admin/Cervezas" class="btn btn-outline-secondary fw-semibold">Cancelar</a>
                        <button type="submit" class="btn btn-warning fw-bold px-4">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>