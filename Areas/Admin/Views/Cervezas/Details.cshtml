@model TiendaWeb.Models.Cerveza

@{
    ViewData["Title"] = "Detalles de la Cerveza";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">Panel de Administración</a>
        </div>
    </nav>

    <div class="container" style="max-width: 600px;">
        <div class="card shadow-sm border-0 rounded m-4">
            <div class="card-header bg-info text-white p-3">
                <h3 class="card-title m-0 h5 fw-bold">Información del Producto</h3>
            </div>

            <div class="card-body p-4 bg-white">
                @if (!string.IsNullOrEmpty(Model.UrlImagen))
                {
                    <div class="text-center mb-4 p-2 bg-light rounded border">
                        <img src="@Model.UrlImagen" alt="Imagen de @Model.nombre" class="img-fluid rounded shadow-sm" style="max-height: 250px; object-fit: contain;" />
                    </div>
                }
                else
                {
                    <div class="text-center mb-4 p-4 bg-light rounded border border-dashed text-muted">
                        <span>Sin imagen disponible</span>
                    </div>
                }

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-secondary fw-bold">Nombre:</span>
                        <span class="text-dark fw-semibold fs-5">@Html.DisplayFor(model => model.nombre)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-secondary fw-bold">Grados de Alcohol:</span>
                        <span class="badge bg-secondary rounded px-2.5 py-1.5 fs-6">@Html.DisplayFor(model => model.alcohol)%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-secondary fw-bold">Estilo Asignado:</span>
                        <span class="badge bg-info text-dark rounded px-2.5 py-1.5 fs-6 fw-semibold">@Html.DisplayFor(model => model.Estilo.Nombre)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-secondary fw-bold">Precio Unitario:</span>
                        <span class="text-success fw-bold fs-5">$@Html.DisplayFor(model => model.precio)</span>
                    </li>
                </ul>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="/Admin/Cervezas" class="btn btn-outline-secondary fw-semibold">Volver al Listado</a>
                    <a href="/Admin/Cervezas/Editar/@Model.Id" class="btn btn-warning fw-bold px-4">Editar Datos</a>
                </div>
            </div>
        </div>
    </div>

</body>
</html>