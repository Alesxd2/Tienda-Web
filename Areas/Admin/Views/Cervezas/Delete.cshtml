@model TiendaWeb.Models.Cerveza

@{
    ViewData["Title"] = "Eliminar Registro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">Panel de Administración</a>
        </div>
    </nav>

    <div class="container" style="max-width: 600px;">
        <div class="card shadow-sm border-0 rounded m-4">
            <div class="card-header bg-danger text-white p-3">
                <h3 class="card-title m-0 h5 fw-bold">¿Confirmas que deseas eliminar este producto?</h3>
            </div>

            <div class="card-body p-4 bg-white">
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <small class="fw-medium">Esta acción no se puede deshacer y el elemento se borrará permanentemente del inventario.</small>
                </div>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2.5">
                        <span class="text-secondary small fw-bold">Producto:</span>
                        <span class="text-dark fw-bold">@Html.DisplayFor(model => model.nombre)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2.5">
                        <span class="text-secondary small fw-bold">Estilo:</span>
                        <span class="badge bg-secondary text-white">@Html.DisplayFor(model => model.Estilo.Nombre)</span>
                    </li>
                </ul>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a href="/Admin/Cervezas" class="btn btn-outline-secondary fw-semibold">Cancelar y Volver</a>
                        <button type="submit" class="btn btn-danger fw-bold px-4">Eliminar Permanentemente</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</body>
</html>